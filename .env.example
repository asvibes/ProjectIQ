# Copy to .env (repo root or backend/) and adjust. Never commit .env.

# development | test | production
APP_ENV=development

# Where uploads, generated files and the SQLite DB live.
# Relative paths are resolved against backend/, not the current directory.
STORAGE_DIR=./storage

# Leave unset to use <STORAGE_DIR>/projectiq.db
# DATABASE_URL=sqlite:///./storage/projectiq.db

# Log every SQL statement (noisy)
SQL_ECHO=false

# ISO 4217 code used when a company or project does not specify one
DEFAULT_CURRENCY=USD

# Copy to .env (repo root or backend/) and adjust. Never commit .env.

# development | test | production
APP_ENV=development

# Where uploads, generated files and the SQLite DB live.
# Relative paths are resolved against backend/, not the current directory.
STORAGE_DIR=./storage

# Leave unset to use <STORAGE_DIR>/projectiq.db
# DATABASE_URL=sqlite:///./storage/projectiq.db

# Log every SQL statement (noisy)
SQL_ECHO=false

# ISO 4217 code used when a company or project does not specify one
DEFAULT_CURRENCY=USD

# Local Ollama server and model used by the AI services (extraction, Q&A, explanations, drafting).
# Keep the URL on localhost so tender and company text stays on this machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Seconds to wait for one model response
OLLAMA_TIMEOUT_SECONDS=120
